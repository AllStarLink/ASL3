#!/usr/bin/python3

import argparse
import logging
import os
import pwd
import re
import requests
import subprocess
import sys
import tempfile

from datetime import datetime
from time import sleep

_ARN_URL = "https://www.arnewsline.org/s/news.mp3"
_SLEEP_AFTER_PLAYBACK_SECONDS = 15


def main():
    # get the options from the CLI
    ap = argparse.ArgumentParser(
        description="Download and play Amateur Radio Newsline")
    ap.add_argument(
        "--node", help="Allstar Node # to play audio", required=True)
    ap.add_argument(
        "--when", help="When to play in 24 hour format NNNN - not specifying --when will result in the audo playing immediately")
    ap.add_argument(
        "--debug", help="enable debug-level logging in syslog", action="store_true")
    args = ap.parse_args()

    # Setup logging
    log = logging.getLogger(__name__)
    lh = logging.StreamHandler()
    lf = logging.Formatter(
        fmt='play-arn: %(name)s: %(levelname)s: %(message)s')
    lh.setFormatter(lf)
    log.addHandler(lh)
    if args.debug:
        log.setLevel(logging.DEBUG)
    else:
        log.setLevel(logging.INFO)

    # Ensure this script is running as 'asterisk' or root.
    try:
        asterisk_uid = pwd.getpwnam("asterisk").pw_uid
    except KeyError:
        sys.exit("Required user 'asterisk' does not exist on this system")

    euid = os.geteuid()
    if euid not in (0, asterisk_uid):
        sys.exit("This script must be run as 'asterisk' (or 'root')")

    # validate the node number is 4-6 digits
    noder = r"^[0-9]{4,6}$"
    if not re.search(noder, args.node):
        sys.exit("Error: nodes are four to six digits")

    # validate --when is in the future
    if args.when:
        numr = r"^[0-9]{4}$"
        if not re.search(numr, args.when):
            sys.exit("Error: Time format must be NNNN")
        now = datetime.now()
        when = now.replace(
            hour=int(args.when[:2]),
            minute=int(args.when[-2:]),
            second=0,
            microsecond=0
        )
        if when < now:
            sys.exit("Error: --when must occur in the future")

    try:
        mp3_out = tempfile.NamedTemporaryFile(suffix=".mp3")
        log.debug(f"mp3_out: {mp3_out.name}")

        # Retrieve the file to a temporary file
        r = requests.get(_ARN_URL)
        if r:
            mp3_out.write(r.content)
        else:
            raise Exception(
                f"Failed to retrieve ARN file with error {r.status_code}")

        # Convert to WAV since sox on Allstar doesn't have .mp3 support
        wav_out = tempfile.NamedTemporaryFile(suffix=".wav")
        log.debug(f"wav_out: {wav_out.name}")
        wav = f"lame -h -S --decode {mp3_out.name} {wav_out.name}"
        log.debug(f"Convert MP3 to WAV: {wav}")
        res = subprocess.run(
            wav.split(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT
        )
        del mp3_out

        if res.returncode != 0:
            raise Exception(f"COMMAND: {wav}\n\n"
                            f"OUTPUT:\n{res.stdout.decode()}")

        # Covert WAV to ULAW
        ulaw_out = tempfile.NamedTemporaryFile(suffix=".ulaw")
        log.debug(f"ulaw_out: {ulaw_out.name}")
        sox = f"sox -v 0.7 {wav_out.name} -r 8k -c 1 -t ul {ulaw_out.name}"
        log.debug(f"Convert WAV to ULAW: {sox}")
        res = subprocess.run(
            sox.split(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT
        )
        del wav_out

        if res.returncode != 0:
            raise Exception("COMMAND: {0:s}\n\n OUTPUT:\n{1:s}".format(
                sox, res.stdout.decode()))

        # Fix perms as temp files are 0600.
        os.chmod(ulaw_out.name, 0o644)

        # delay the playback until --when if specified
        if args.when:
            naptime = (when-datetime.now()).total_seconds()
            log.debug(f"sleeping for {naptime}")
            sleep(naptime)

        # play the audio
        ulaw_path_no_ext, _ = os.path.splitext(ulaw_out.name)
        astplay = [
            "/usr/sbin/asterisk",
            "-rx",
            "rpt playback {0:s} {1:s}".format(
                args.node, ulaw_path_no_ext)
        ]
        log.debug(f"Play Asterisk: {astplay}")
        res = subprocess.run(
            astplay,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT
        )
        if res.returncode != 0:
            raise Exception("COMMAND: {0:s}\n\n OUTPUT:\n{1:s}".format(
                " ".join(astplay), res.stdout.decode()))

        # sleep for 15 seconds so the playback starts before the
        # deconstructor deletes the temporary file for ulaw_out
        # don't want a different script needed to clean up /tmp
        log.debug(f"sleeping for {_SLEEP_AFTER_PLAYBACK_SECONDS} "
                  "seconds for playback to start")
        sleep(_SLEEP_AFTER_PLAYBACK_SECONDS)
        del ulaw_out

    except Exception as e:
        sys.exit(f"Error: {e}")


if __name__ == "__main__":
    try:
        main()
        sys.exit()

    except KeyboardInterrupt:
        sys.exit("\nInterrupted by user")

