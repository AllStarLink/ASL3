BI_AUDIO="/usr/share/asterisk/sounds/en"
CU_AUDIO="/var/lib/asterisk/sounds/en"

DATE_ARG=""
DATE_CMD="date"

function ast_rx_lp(){
	asterisk -rx "rpt localplay ${NODE} $1" 2>&1
}

function build_and_say(){

	if [[ -n "$ASL_SAY_TESTING" ]]; then
		echo "[$DATE_ARG] $*"
		exit
	fi

	TMPAUD=$(mktemp --suffix=.ulaw)
	chmod 644 ${TMPAUD}
	ASTAUD=$(echo ${TMPAUD} | sed -e 's/\.ulaw//g')
	SIA="-t ul -r 8k -c 1"
	for e in $*
	do
		if [ -f "${CU_AUDIO}/${e}.ulaw" ]; then
			F_IN="${F_IN} ${SIA} ${CU_AUDIO}/${e}.ulaw"
			continue
		fi
		if [ -f "${BI_AUDIO}/${e}.ulaw" ]; then
			F_IN="${F_IN} ${SIA} ${BI_AUDIO}/${e}.ulaw"
			continue
		fi
	done
	sox --combine concatenate -c 1 -r 8k \
		${F_IN} -t ul ${TMPAUD}
	ast_rx_lp ${ASTAUD}
	sleep 10
	rm ${TMPAUD}
}

function get_date(){
	DAY=$(eval $DATE_CMD +%w)
	MONTH=$(eval $DATE_CMD +%m | sed -e 's/^0//')
	MONTH=$((MONTH - 1))
	DAY_OF_MONTH=$(eval $DATE_CMD +%d | sed -e 's/^0//')

	# add the day-of-week audio
	DAY_FULL="digits/day-$DAY"

	# add the month audio
	MONTH_FULL="digits/mon-$MONTH"

	# add the day-of-month audio
	if (( ${DAY_OF_MONTH} < 20 )); then
		DAY_OF_MONTH_FULL="digits/h-${DAY_OF_MONTH}"
	else
		A=$(( ${DAY_OF_MONTH} / 10 ))
		B=$(( ${DAY_OF_MONTH} % 10 ))
		if (( $B == 0 )); then
			DAY_OF_MONTH_FULL="digits/h-${A}0"
		else
			DAY_OF_MONTH_FULL="digits/${A}0 digits/h-${B}"
		fi
	fi

	echo "digits/today is ${DAY_FULL} ${MONTH_FULL} ${DAY_OF_MONTH_FULL}"
}

function get_time(){
	HOUR=$(eval $DATE_CMD +%I | sed -e 's/^0//')
	MINUTE=$(eval $DATE_CMD +%M | sed -e 's/^0//')

	# add the hour audio
	HOUR_FULL="digits/${HOUR}"

	# add the minute audio
	if (( ${MINUTE} == 0 )); then
		MINUTE_FULL="digits/oclock"
	elif (( ${MINUTE} < 10 )); then
		MINUTE_FULL="digits/oh digits/${MINUTE}"
	elif (( ${MINUTE} < 20 )); then
		MINUTE_FULL="digits/${MINUTE}"
	else
		A=$(( ${MINUTE} / 10 ))
		B=$(( ${MINUTE} % 10 ))
		if (( $B == 0 )); then
			MINUTE_FULL="digits/${A}0"
		else
			MINUTE_FULL="digits/${A}0 digits/${B}"
		fi
	fi

	# add am/pm
	AM_PM=$(eval $DATE_CMD +%P | sed 's/^\([ap]\)\(m\)/\1-\2/')

	# add the timezone with letters prefix
	TIMEZONE=$(eval $DATE_CMD +%Z | tr '[A-Z]' '[a-z]' | sed 's/./letters\/& /g')

	echo "rpt/thetimeis ${HOUR_FULL} ${MINUTE_FULL} digits/${AM_PM} ${TIMEZONE}"
}

function get_time24(){
	HOUR=$(eval $DATE_CMD +%-H)
	MINUTE=$(eval $DATE_CMD +%0M | sed -e 's/^0//')

	# add the hour audio
	if (( ${HOUR} == 0 )); then
		HOUR_FULL="digits/0"
	elif (( ${HOUR} < 10 )); then
		HOUR_FULL="digits/oh digits/${HOUR}"
	elif (( ${HOUR} < 20 )); then
		HOUR_FULL="digits/${HOUR}"
	else
		A=$(( ${HOUR} / 10 ))
		B=$(( ${HOUR} % 10 ))
		if (( $B == 0 )); then
			HOUR_FULL="digits/${HOUR}"
		else
			HOUR_FULL="digits/${A}0 digits/${B}"
		fi
	fi

	# add the minute audio
	if (( ${MINUTE} == 0 )); then
		MINUTE_FULL="digits/hundred"
	elif (( ${MINUTE} < 10 )); then
		MINUTE_FULL="digits/oh digits/${MINUTE}"
	else
		A=$(( ${MINUTE} / 10 ))
		B=$(( ${MINUTE} % 10 ))
		if (( ${MINUTE} < 20 )); then
			MINUTE_FULL="digits/${MINUTE}"
		else
			MINUTE_FULL="digits/${A}0 digits/${B}"
		fi
	fi

	# add the timezone with letters prefix
	TIMEZONE=$(eval $DATE_CMD +%Z | tr '[A-Z]' '[a-z]' | sed 's/./letters\/& /g')

	echo "rpt/thetimeis ${HOUR_FULL} ${MINUTE_FULL} ${TIMEZONE}"
}

function get_ip4(){
	IP=$(ip -4 -o a | cut -d ' ' -f 2,7 | cut -d '/' -f 1 |\
		grep -v 127.0. | awk '{print $2}')
	for e in $(echo ${IP} | sed 's/./& /g')
	do
		case $e in
			.)	IP_SAY="${IP_SAY} letters/dot" ;;
			*)	IP_SAY="${IP_SAY} digits/$e" ;;
		esac
	done
	echo "letters/i letters/p ${IP_SAY}"
}

function get_ip6(){
	IP=$(ip -6 addr | grep inet6 | awk -F '[ \t]+|/' '{print $3}' |\
		 grep -v ^::1 | grep -v ^fe80)
	for e in $(echo ${IP} | sed 's/./& /g')
	do
		case $e in
			:)  IP_SAY="${IP_SAY} letters/dot" ;;
			[abcdef])  IP_SAY="${IP_SAY} letters/$e" ;;
			*)  IP_SAY="${IP_SAY} digits/$e" ;;
		esac
	done
	echo "letters/i letters/p digits/6 ${IP_SAY}"
}

function usage(){
	echo "Usage: $0 -n {NODE} -w ( date |  time | time24 | datetime | datetime24 | ip4 | ip6 )" 1>&2
	exit 1
}

# If no command-line arguments
if (( $# == 0 )); then
  usage
fi

while getopts "n:w:d:" opt; do
	case ${opt} in
		n)	NODE="${OPTARG}" ;;
		w)	WHAT="${OPTARG}" ;;
		d)	DATE_ARG="-d \"${OPTARG}\""
			DATE_CMD+=" $DATE_ARG"
			;;
		*)	usage ;;
	esac
done
shift $((OPTIND-1))

if case $NODE in (*[!0-9]*|'') true;; (*) false;; esac; then
	echo "-n {NODE} must be a number" 1>&2
	exit 1
fi

if [ -z "${NODE}" ] || [ ${NODE} -lt 1 ]; then
	echo "-n {NODE} must be a number greater than 0" 1>&2
	exit 1
fi

case ${WHAT} in
	date)		build_and_say $(get_date) ;;
	datetime)	build_and_say $(get_date) $(get_time) ;;
	datetime24)	build_and_say $(get_date) $(get_time24) ;;
	time)		build_and_say $(get_time) ;;
	time24)		build_and_say $(get_time24) ;;
	ip | ip4) 	build_and_say $(get_ip4) ;;
	ip6)		build_and_say $(get_ip6) ;;
	*) 			usage ;;
esac

exit 0

